{{!< default}}
{{#post}}
<main id="main-content">
    <article class="article {{post_class}}">
        {{#match @page.show_title_and_feature_image}}
            <header class="article-header shell">
                <a class="back-link" href="{{@site.url}}">← All articles</a>
                <div class="article-heading"><h1>{{title}}</h1></div>
                {{#if feature_image}}<figure class="article-cover"><img src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">{{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}</figure>{{/if}}
            </header>
        {{/match}}
        <section class="gh-content gh-canvas">{{content}}</section>
    </article>
</main>
{{/post}}
