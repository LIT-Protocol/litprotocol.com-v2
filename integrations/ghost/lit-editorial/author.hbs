{{!< default}}
<main id="main-content" class="shell">
    <header class="index-header archive-header">
        <a class="back-link" href="{{@site.url}}">← All articles</a>
        {{#author}}<h1>{{name}}</h1>{{#if bio}}<p>{{bio}}</p>{{/if}}{{/author}}
    </header>
    <div class="post-feed">{{#foreach posts}}{{> "post-card"}}{{/foreach}}</div>
    {{pagination}}
</main>
